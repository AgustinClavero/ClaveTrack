# ClaveTrack — variables de entorno
# Copiá este archivo a .env.local y completá los valores de tu proyecto Supabase.

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable) — segura para el cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service role — SOLO servidor, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# URL de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000
